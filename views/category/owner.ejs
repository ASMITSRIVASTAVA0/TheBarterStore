<!-- layout keyword h joki ejs-mate me defined-->
<% layout("/layouts/boilerplate") %>

<style>
    .card li{
        padding:0.7rem;
        background-color:black;
    }
    @media(max-width:650px){
      .card{
        height:30vh;
        width:30vh;
      }
    }
</style>

<body>
    <h1 style="color:crimson;" class="offset-">About Me:</h1>
   
      <br><br>
      <div class="card mb-3 offset- " style="max-width: 540px;  font-weight: 700; background-color: crimson;">
        <div class="row g-0">
          <div class="col-md-4">
            <img 
            src="https://www.svgrepo.com/show/382368/avatar-emoji-emoticon-emotion-expression-profile.svg" 
            class="img-fluid rounded-start" style="background-size:repeat;" 
            alt="..." height="300rem" width="300rem">
          </div>
          <div class="col-md-8"style="background-color: black;">
            <div class="card-body " >
              <h5 class="card-title"><h2 style="opacity: 1; font-weight: 900; font-family:cursive; font-size:2rem;"><%=owner.username%></h2></h5>
              <hr>
              <p class="card-text"><%=owner.bio%></p>
              <p class="card-text"><small class="text-body-secondary"><b>Email:</b><%=owner.email%></small></p>
              <p class="card-text"><small class="text-body-secondary"><b>Year of Graduation:</b><%=owner.year%></small></p>
              
            </div>
          </div>
        </div>
      </div>
   
</body>



