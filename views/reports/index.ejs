<% layout("/layouts/boilerplate.ejs") %>
<style>
  .inside-card{
    display:flex;
    flex-direction:row;
    justify-content:space-between;
  }
  .inside-card div{
    margin:0.4rem 1rem 0.4rem 1rem;
  }
