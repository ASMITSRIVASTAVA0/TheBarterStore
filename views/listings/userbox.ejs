<% layout("/layouts/boilerplate.ejs") %>
<style>
  .card{
    margin:1rem;
  }
</style>
<body>
    
    <h1 style="color:crimson;">Inbox <i class="fa-brands fa-facebook-messenger"></i></h1>
    <br>
    <div class="row">

      <% for(Message of allMessage) { %>

        <!-- <div class="col-sm-3 col-md-6 mb- mb-sm-0"> -->
          <div>


          <div class="card bg-light border-warning" style="color:black; padding:0.4rem;">
            <div class="card-body" style="padding:1rem;">
              <!-- <h4 style="color:crimson" card-title">@</h4> -->
              <!-- <h5 style="color:black" class="card-text">&nbs</h5> -->
              <h3 style="color:rgb(0, 13, 255);">@<%=Message.from.username%></h3>
              <h5>Message:<%=Message.message%></h5>
              <h5>Product:<%=Message.product.title%></h5>
              <h5>Address:<%=Message.address%></h5>
              <h5>Contact No.<%=Message.contact%></h5>
              
              <b style="color:crimson;">@<%=Message.from.username%> is interested in buying your product @<%=Message.product.title%>, 
                Information of buyer is provided above, if interested in selling your product,
            kindly contact @<%=Message.from.username%></b>
              <!-- <a style="margin:0.5rem;" href="#" class="btn btn-primary">Reply</a> -->
              <p style="opacity:0.7;">Send on:<%=Message.createdAt.toLocaleString().split(", ")[0]%></p>

            </div>
          </div>

          

        </div>
        

      <% } %>


         


    </div> 

        

        
  

</body>