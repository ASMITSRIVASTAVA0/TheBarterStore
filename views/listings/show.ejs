<% layout("/layouts/boilerplate") %>
<body>

    
    <!-- mt==margin from top 3 diya -->
    <div class="row mt-3" >

        <div class="col-8 offset-1">
            <h3 style="color:crimson;"><%=listing.title%></h3>
            <br>
        </div>
        <!-- ek bootstrap ke card me pura data show kiya -->
        <div class="card col-9 offset-1
        listing-card" >
            <img class="show-img"src="<%=listing.image.url%>" alt="image" style="height:50vh; width:36vh; margin:0;">
            <div class="card-body bg-body-light">
                <p class="card-text">
                    
                    <form method="GET" action="/listings/owner/<%=listing.owner._id%>">
                        <button class="btn btn-outline-danger">Know About Owner</button>
                    </form>
                    <br>
                                
    
                    <%= listing.description %>
                    <br><br>
                    Price:&nbsp;&nbsp;&#8377;<%=listing.price.toLocaleString("en-IN")%>
                    <br>
                    <!-- Category: -->
                    This is for <%=listing.year%> students;
                    <br>
                    Condition:&nbsp;&nbsp;<%=listing.condition%>
                    
                    <!-- Country:-->

                    
                    
                    <br><br>
                    <!-- btn unhi user ko dikhe jo unke owner -->
                    <!-- agar midware me error to currUser store n hua islliye if m -->
                    
                    <!-- agar curruser logged ho aur -->
                    <% if(currUser &&( listing.owner._id.equals(currUser._id) || currUser.admin)) { %>
                        <div class="btns">
                            <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark add-btn"><i class="fa-solid fa-pen-nib"></i> Edit</a>
                            &nbsp;&nbsp;&nbsp;&nbsp;
                            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                                <button class="btn btn-secondary"><i class="fa-solid fa-trash"></i> Delete</button>
                            </form>
                
                        </div>
                        <br>
                        
                    <br>
                    <% } %>
                    <form method="GET" action="/listings/<%=listing._id%>/buy">
                        <button class="btn btn-success"><i class="fa-solid fa-cart-shopping"></i> Buy Now</button>
            
                    </form>
                    
                   
                <hr>
                <% if(currUser) { %>
                    <div class="col-8 ">
                        <h3 style="color:crimson;">Leave a Review</h3>
                        <!-- validations=== -->
                        <!-- step1=novalidate -->
                        <!-- step2=class=need-validate -->
                        <!-- step3=textarea=required -->

                        <!-- for server(hopscotch) validations -->
                        <!-- step1=joi schema -->
                        <!-- step2=schema validate func -->
                        <!-- middleware  -->
                        <form method="POST" action="/listings/<%=listing._id%>/reviews"
                            novalidate 
                            class="needs-validation">
                            <!-- mb==marginbottom3 mt==margintop-->
                            <div class="mb-3 mt-3">
                                
                
                                <!-- github se copy paste -->
                                <label for="rating" class="form-label">Rating</label>
                                <fieldset class="starability-growRotate">
                                    <!--  -->
                                    <!-- <legend>First rating:</legend> -->
                                    <!-- <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." /> -->
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>


                            </div>
                            <div class="mb-3 mt-3">
                                <label for="comment" class="form-label">Comment Here</label>
                                <textarea
                                name="review[comment]"
                                id="comment"
                                cols="90"
                                rows="5"
                                class="form-control"
                                required
                                style="width:30vh;"

                                ></textarea>

                                <div class="invalid-feedback">Please add some comments for review</div>

                            </div>
                            <!-- <button>submit</button> -->
                            
                            <!-- review post hoga review db me -->
                            <!-- chuki review connected h listingid se isliye -->
                            <!-- send req to /listings/:id/reviews -->
                            <button class="btn btn-secondary"><i class="fa-solid fa-share-from-square"></i> Submit</button>
                        </form>

                    
                    </div>
                    <hr>

                <% } %>
                    
                    <!-- isse objid print to listing pass krte time populate kr do-->
                    <h3 style="color:crimson">All Reviews</h3>
                    <br>
                    <ul>
                        <!-- agar ek review h tbhi section dikhao -->
                        <% if(listing.reviews.length>0) { %>
                        
                        <div class="row">
                            
                            <!-- listings.reviews me ObjectId store h to populate k use krke review nikala -->
                            <% for(review of listing.reviews) { %>
                                <div class="card col-9 mb-3  bg-body-tertiary" style="width:100vh;">
                                    <!-- ms===margin-start -->
                                    <div class="card-body" >
                                        <h5 class="card-title">@<%= review.author.username %></h5>
                                        <p class="starability-result card-text" data-rating="<%=review.rating%>">
                        
                                        </p>
                                        <p class="card-text"><%=review.comment%></p>
                                        <!-- to servser static result ofrating -->
                                        
                                        <% if(currUser && (currUser.admin || review.author._id.equals(currUser._id) ) ){ %>
                                            <form 
                                            method="POST" 
                                            action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                                <button class="btn btn-danger btn-sm md-3"><i class="fa-solid fa-trash"></i> Delete</button>
                                            </form>
                                        <% } %>
                                        
                                        <p class="card-text"><%=review.createdAt.toLocaleString().split(", ")[0]%></p>
                                    </div>
                                </div>

                                
                            <% } %>
                           

                        </div>
                        <% } %>

                        
                    </ul>
                    
                    
                </p>
                <hr>
            </div>
           
            <br>
            <div>

                <form method="GET" action="/listings/<%=listing._id%>/reports">
                    <button class="btn btn-outline-danger">Report</button>
            
                </form>
            </div>
            
        </div>

        

    </div>
    
    <script>
       
    </script>

    
    
</body>
