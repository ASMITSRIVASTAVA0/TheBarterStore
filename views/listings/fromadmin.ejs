<% layout("/layouts/boilerplate.ejs") %>
<style>
  .card{
    margin:1rem;
  }
  
</style>
<body>
    <div style="display:flex; flex-direction:row; justify-content:space-between;">
      <div>
        <h1 style="color:crimson;">Inbox <i class="fa-brands fa-facebook-messenger"></i></h1>
    
      </div>
      <div>
        <form action="/listings/inbox/fromadmin">
          <button class="btn btn-warning">From Admin</button>
        </form>
      </div>
    </div>
    <br>
    <div class="row">
      

      <% for(Message of allMessage) { %>
       <% if( ! Message.from.admin) { %> 
        <!-- <div class="col-sm-3 col-md-6 mb- mb-sm-0"> -->
          <div>

        
          <div class="card bg-light border-warning" style="color:black; padding:0.4rem;">
            <div class="card-body" style="padding:1rem;">
              <!-- <h4 style="color:crimson" card-title">@</h4> -->
              <!-- <h5 style="color:black" class="card-text">&nbs</h5> -->
              <h3 style="color:rgb(0, 13, 255);">@ADMIN</h3>
              <h4><%=Message.message%></h4>
              
              
              <!-- <a style="margin:0.5rem;" href="#" class="btn btn-primary">Reply</a> -->
              <p style="opacity:0.7;">Send on:<%=Message.createdAt.toLocaleString().split(", ")[0]%></p>
              
              
            </div>
          </div>

          

        </div>

        <% } %> 
        

      <% } %>


         


    </div> 

        

        
  

</body>