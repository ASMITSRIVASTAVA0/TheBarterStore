<% layout("/layouts/boilerplate") %>

<style>
    .card li{
        padding:0.7rem;
        background-color:black;
    }
</style>

<body>
    
    <h1 style="color:crimson"class="offset-3">Check Credentials</h1>
    <br><br>
    <div class="col-8 offset- container-sm">
        <form action="/listings/<%=listing._id%>/buy" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="name" class="form-label"><h5>Name:</h5></label>
                <input 
                name=""
                id="name"
                type="text"
                class="form-control bg-secondary"
                style="color:black; font-size:1.2rem; font-weight:500;"
                value="<%=currUser.username%>"
                required
                >

                <div class="valid-feedback">Looks Good!</div>
                <div class="invalid-feedback">Please provide your good name!</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label"><h5>Email:</h5></label>
                <input 
                name=""
                id="name"
                type="text"
                class="form-control bg-secondary"
                style="color:black; font-size:1.2rem; font-weight:500;"
                value="<%=currUser.email%>"
                required>

                <div class="valid-feedback">Looks Good!</div>
                <div class="invalid-feedback">Please provide your good name!</div>
            </div>
            <div class="mb-3">
                <label for="contact" class="form-label"><h5>Contact No:</h5></label>
                <input 
                name="info[contact]"
                id="name"
                type="text"
                class="form-control bg-secondary"
                style="color:black; font-size:1.2rem; font-weight:500;"
                placeholder="Enter Contact No."
                
                required>

                <div class="valid-feedback">Looks Good!</div>
                <div class="invalid-feedback">Please provide your good name!</div>
            </div>
            <div class="mb-3">
                <label for="address" class="form-label"><h5>Address:</h5></label>
                <input 
                
                name="info[address]"
                id="address"
                type="text"
                class="form-control bg-secondary"
                style="color:black; font-size:1.2rem; font-weight:500;"
                placeholder="Enter Address"
                
                required>

                <div class="valid-feedback">Looks Good!</div>
                <div class="invalid-feedback">Please provide your good name!</div>
            </div>
            <div class="mb-3">
                <label for="username" class="form-label"><h5>Message:</h5></label>
                <textarea
                
                name="info[message]"
                id="message"
                type="text"
                class="form-control bg-secondary"
                cols="30"
                rows="7"

                placeholder="Send Customize Message to Seller"
                style="color:black; font-size:1.2rem; font-weight:500;"
                required></textarea>

                <div class="valid-feedback">Your feedback improves us!</div> 
                <div class="invalid-feedback">Please Provide Feedback!</div>
            </div>
            


            

            <button class="btn btn-primary"><i class="fa-solid fa-share-from-square"></i> Confirm Order</button>
        </form>
        <br><br>
    </div>
        
    

</body>



