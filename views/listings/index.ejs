<!-- layout keyword h joki ejs-mate me defined-->
<% layout("/layouts/boilerplate") %>
    <style>
        #filters{
            display:flex;
            flex-wrap:wrap;
            align-items: center;
        }
        .filter{
            text-align:center;
            margin-right:2rem;
            margin-top:1rem;
            opacity:0.7;
        }
        .filter:hover{
            opacity:1;
            cursor:pointer;
        }
        
        .tax-info{
            /* hidden me jagah leta dikhta nhi none me n jagah n dikhta */
            display: none;
        }
        .tax-toggle{
            border:1px solid black;
            border-radius:0.5rem;
            height:2.6rem;
            padding:1rem;
            /* margin-left:2rem; */
            background-color:crimson;
            display:flex;
            align-items: center;
            margin-right:2rem;
        }
        .tax-toggle:hover{
            background-color: rgb(183, 8, 43);
        }
        .top-divs{
            display: flex;
            justify-content: space-between;
        }

        /* filter csss */
        .dropdown-item{
    /* padding:0.75rem; */
    /* padding-right:3rem; */
    /* color:crimson; */
  }

        
            
        @media(max-width:650px)
        {
            /* .sell-form{
                /* display: block; */
            
            /* .dropdown-toggle{ */
                /* display: block; */
                /* margin-left:7rem; */
            /* } */
            /* .top-divs{
                display: flex;
                flex-direction:column;
            } */ 
        }
    </style>
<body>
    <br>

    
    <!-- %> -->
    <h1 style="color:crimson; font-size:3rem;">TheBarter Store</h1>
    <br>
        
    <div class="top-divs">
        <form class="sell-form"method="GET" action="/listings/new"> 
            <button class="btn btn-secondary btn-sell"><i class="fa-solid fa-share-from-square"></i> Sell Product</button>
        </form>
      
    
    
        <li class="nav-item dropdown">
        <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-filter"></i> Apply Filter &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;      &nbsp; &nbsp;&nbsp; 
        </button>
        <ul class="dropdown-menu dropdown-menu-dark">

        
            
            <li style="background-color: black; color:black !important;"><a class="dropdown-item" href="/listings/filter"><h5><i class="fa-solid fa-mountain-city"></i> Books for 1st Year </h5></a></li>
            <li style="background-color: white;"><a style="color:black;"class="dropdown-item" href="/listings/filter"><h6><i class="fa-solid fa-igloo"></i> Books for 2st Year</h6></a></li>
            <li style="background-color: black;"><a class="dropdown-item" href="/listings/filter"><h5><i class="fa-solid fa-ship"></i> Books for 3st Year</h5></a></li>
            <li style="background-color: white;"><a style="color:black;"class="dropdown-item" href="/listings/filter"><h5><i class="fa-solid fa-hill-avalanche"></i> Books for 4st Year</h5></a></li>
        
            
            
        </ul>
        </li>
            
          

    </div>

    
    <!-- ye form get req bhejaga url me -->
    
    <br>
    <!-- row bootstrap ki class -->
    <!-- chahte ek row me 1,2,3 cols hi aate to row-cols-md-x -->
    <div class="row row-cols-lg-3 row-cols-md- row-cols-sm-1 mt-3">
        <!-- ek (row) me 3 (cols) jb screen (lg)  -->
        <%   for(listing of allListings){  %>
            <!-- GET /listings/:id (show route) for specific list -->
            <!-- href me get req aygei MAY be bcz it is default req type-->
            <!-- bootstrap k card -->
            
            <a href="/listings/<%=listing._id%>" class="a-card-link">
                <div class="card bg-dark
                listing-card" style="width:16.5rem">
                    <img style="height:20rem" src="<%=listing.image.url%>" class="card-img-top" alt="listing_image">
                    <!-- agar img ke upar koi text overlay krna -->
                    <!-- <div class="card-img-overlay">abcd</div> -->
                    <div class="card-body bg-dark">
                        <p class="card-text bg-dark">
                            <b><%=listing.title%></b>
                            <br>
                            &#8377; <%=listing.price.toLocaleString("en-IN") %> 
                            <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                        </p>
                    </div>
                    <div class="card-img-overlay"><%=listing.title%></div>
                    
                </div>
            </a>
            

        <% } %>
    </div>

    <script>
        let taxSwitch=document.getElementById("flexSwitchCheckDefault");
        taxSwitch.addEventListener("click",()=>{
            // res.flash("success","Tax Applied!");
            let taxInfo=document.getElementsByClassName("tax-info");
            console.log(taxInfo);
            for(info of taxInfo)
            {
                if(info.style.display!="inline")
                info.style.display="inline";
                else
                info.style.display="none";
            }
        })
    </script>

</body>



